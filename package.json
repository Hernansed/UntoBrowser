{
  "name": "unto-browser",
  "productName": "Unto Browser",
  "version": "0.8.1",
  "description": "Unto — a full cross-platform (Windows/Linux) Chromium-based browser with the Unto start page.",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never",
    "dist": "npm run dist:linux && npm run dist:win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unto.browser",
    "productName": "Unto Browser",
    "executableName": "unto",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "scripts/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["deb", "rpm"],
      "maintainer": "Hernansed <hernansed@users.noreply.github.com>",
      "category": "Network"
    }
  }
}
